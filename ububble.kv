# """Welcome to U-Bubble's frontend"""
MDFloatLayout:
    # --- Screen Management ---
    # Manages all the different screens of the application.
    ScreenManager:
        id: screen_manager
        MainScreen:
        SettingsScreen:
        ClassAddScreen:
        SignInScreen:
        WebsiteDataScreen:
        ClassEditScreen:
        ClassesScreen:

    # --- Global Notification ---
    # A notification that floats above all screens to display messages.
    TopNotification:
        id: global_notif

# --- Notification Widget Style ---
# Defines the appearance of the TopNotification widget.
<TopNotification>:
    size_hint: 0.85, None  # 85% of screen width, height is automatic
    height: "50dp"
    pos_hint: {"center_x": 0.5, "top": 1.2}  # Centered, initially off-screen
    elevation: 3
    radius: [12]
    md_bg_color: 0.15, 0.15, 0.15, 1  # Dark gray background

    MDLabel:
        text: root.message_text
        theme_text_color: "Custom"
        text_color: root.message_color
        halign: "center"
        bold: True

# --- Main Screen ---
# The main landing screen of the application.
<MainScreen>:
    name: "main"
    MDFloatLayout:
        md_bg_color: 0.1, 0.1, 0.1, 1  # Dark background

        # --- Top Navigation ---
        MDRaisedButton:
            id: sign_in_button
            text: "Sign in"
            elevation: 2
            pos_hint: {"top": 0.96, "x": 0.04}
            on_release: root.manager.current = "sign in"
            font_name: "Comic"
            md_bg_color: 0.3, 0.2, 0.4, 1  # Purple
            text_color: 1, 1, 1, 1  # White

        MDIconButton:
            icon: "cog"
            pos_hint: {"top": 0.97, "right": 0.96}
            on_release: root.manager.current = "settings"
            icon_size: "48sp"
            theme_text_color: "Custom"
            text_color: 0.8, 0.6, 1, 1  # Light purple

        # --- Header ---
        MDLabel:
            text: "U-Bubble"
            font_style: "H2"
            bold: True
            halign: "center"
            pos_hint: {"center_y": 0.88}
            theme_text_color: "Custom"
            text_color: 0.8, 0.6, 1, 1  # Light purple
            font_name: "data/fonts/Roboto-BoldItalic.ttf"

        # --- Classes Card ---
        MDCard:
            orientation: "vertical"
            size_hint: 0.85, 0.25
            pos_hint: {"center_x": 0.5, "center_y": 0.65}
            elevation: 2
            radius: [24]
            padding: "16dp"
            md_bg_color: 0.2, 0.2, 0.2, 1  # Darker card

            MDLabel:
                text: "Classes"
                font_style: "H4"
                bold: True
                halign: "center"
                size_hint_y: None
                height: self.texture_size[1]
                font_name: "RobotoLight"
                theme_text_color: "Custom"
                text_color: 0.9, 0.9, 0.9, 1  # Light gray

            Widget:  # Spacer

            MDBoxLayout:
                orientation: "horizontal"
                spacing: "20dp"
                pos_hint: {"center_x": 0.5}
                size_hint_x: 0.8

                MDFillRoundFlatIconButton:
                    text: "Edit"
                    icon: "pencil"
                    pos_hint: {"center_y": 0.5}
                    size_hint_x: 0.5
                    on_release: root.manager.current = "edit class"
                    font_name: "RobotoMedium"
                    md_bg_color: 0.4, 0.3, 0.5, 1  # Dark purple

                MDFillRoundFlatIconButton:
                    text: "Add"
                    icon: "plus"
                    pos_hint: {"center_y": 0.5}
                    size_hint_x: 0.5
                    on_release: root.manager.current = "add a class"
                    font_name: "RobotoMedium"
                    md_bg_color: 0.4, 0.3, 0.5, 1  # Dark purple

        # --- Updates Card ---
        MDCard:
            orientation: "vertical"
            size_hint: 0.85, 0.25
            pos_hint: {"center_x": 0.5, "center_y": 0.35}
            elevation: 2
            radius: [24]
            padding: "16dp"
            md_bg_color: 0.2, 0.2, 0.2, 1  # Darker card

            MDLabel:
                text: "Get assignments"
                font_style: "H4"
                bold: True
                halign: "center"
                size_hint_y: None
                height: self.texture_size[1]
                font_name: "RobotoLight"
                theme_text_color: "Custom"
                text_color: 0.9, 0.9, 0.9, 1  # Light gray

            Widget:  # Spacer

            MDBoxLayout:
                orientation: "horizontal"
                spacing: "20dp"
                pos_hint: {"center_x": 0.5}
                size_hint_x: 0.8

                MDRaisedButton:
                    text: "Auto (disabled)"
                    pos_hint: {"center_y": 0.5}
                    size_hint_x: 0.5
                    disabled: True
                    font_name: "RobotoMedium"

                MDFillRoundFlatIconButton:
                    text: "Classes page"
                    icon: "view-list"
                    pos_hint: {"center_y": 0.5}
                    size_hint_x: 0.5
                    on_press: root.manager.current = "classes"
                    font_name: "RobotoMedium"
                    md_bg_color: 0.4, 0.3, 0.5, 1  # Dark purple

# --- Settings Screen ---
# Allows the user to configure application settings.
<SettingsScreen>:
    name: "settings"
    on_enter: root.load_settings()
    MDFloatLayout:
        md_bg_color: 0.1, 0.1, 0.1, 1  # Dark background

        MDLabel:
            text: "Settings"
            font_style: "H4"
            bold: True
            halign: "center"
            pos_hint: {"top": 0.95}
            theme_text_color: "Custom"
            text_color: 0.8, 0.6, 1, 1  # Light purple
            font_name: "Roboto"

        MDIconButton:
            icon: "home"
            pos_hint: {"top": 0.97, "right": 0.96}
            on_release: root.manager.current = "main"
            icon_size: "48sp"
            theme_text_color: "Custom"
            text_color: 0.8, 0.6, 1, 1  # Light purple

        MDCard:
            orientation: "vertical"
            size_hint: 0.85, 0.8
            pos_hint: {"center_x": 0.5, "center_y": 0.45}
            elevation: 2
            radius: [24]
            padding: "24dp"
            spacing: "20dp"
            md_bg_color: 0.2, 0.2, 0.2, 1  # Darker card

            MDFillRoundFlatIconButton:
                icon: "google"
                text: "Connect Google"
                md_bg_color: 0.8, 0.1, 0.1, 1  # Red
                font_size: "18sp"
                pos_hint: {"center_x": 0.5}
                size_hint_x: 0.9
                on_press: root.connect_google()
                font_name: "Roboto"

            MDSeparator:
                size_hint_x: 0.6
                pos_hint: {"center_x": 0.5}
                color: 0.4, 0.3, 0.5, 1  # Dark purple

            MDRaisedButton:
                text: "Connect Blackboard"
                id: connect_blackboard_button
                pos_hint: {"center_x": 0.5}
                size_hint_x: 0.8
                on_press: root.choose_website("blackboard")
                on_release: root.manager.current = "enter web data"
                font_name: "Roboto"
                md_bg_color: 0.4, 0.3, 0.5, 1  # Dark purple

            MDRaisedButton:
                text: "Connect Zybooks"
                id: connect_zybooks_button
                pos_hint: {"center_x": 0.5}
                size_hint_x: 0.8
                on_press: root.choose_website("zybooks")
                on_release: root.manager.current = "enter web data"
                font_name: "Roboto"
                md_bg_color: 0.4, 0.3, 0.5, 1  # Dark purple

            MDRaisedButton:
                text: "Connect Cengage"
                id: connect_cengage_button
                pos_hint: {"center_x": 0.5}
                size_hint_x: 0.8
                on_press: root.choose_website("cengage")
                on_release: root.manager.current = "enter web data"
                font_name: "Roboto"
                md_bg_color: 0.4, 0.3, 0.5, 1  # Dark purple

            MDRaisedButton:
                text: "Connect Demo"
                id: connect_demo_button
                pos_hint: {"center_x": 0.5}
                size_hint_x: 0.8
                on_press: root.choose_website("demo")
                on_release: root.manager.current = "enter web data"
                font_name: "Roboto"
                md_bg_color: 0.4, 0.3, 0.5, 1  # Dark purple

            MDLabel:
                text: "Gemini API Setup"
                font_style: "H6"
                halign: "center"
                size_hint_y: None
                height: self.texture_size[1]
                theme_text_color: "Custom"
                text_color: 0.9, 0.9, 0.9, 1  # Light gray
                font_name: "Roboto"

            MDBoxLayout:
                orientation: "horizontal"
                size_hint_y: None
                height: "48dp"
                spacing: "10dp"
                pos_hint: {"center_x": 0.5}

                MDRaisedButton:
                    text: "Get Key"
                    on_release: root.get_gemini_key()
                    size_hint_x: 0.3
                    font_name: "Roboto"
                    md_bg_color: 0.4, 0.3, 0.5, 1  # Dark purple

                MDTextField:
                    id: api_key_field
                    hint_text: "Paste API Key"
                    mode: "rectangle"
                    password: True
                    size_hint_x: 0.4
                    font_name: "Roboto"
                    line_color_normal: 0.4, 0.3, 0.5, 1  # Dark purple
                    line_color_focus: 0.8, 0.6, 1, 1  # Light purple
                    text_color_normal: 0.9, 0.9, 0.9, 1  # Light gray
                    hint_text_color: 0.6, 0.6, 0.6, 1  # Gray

                MDFillRoundFlatButton:
                    text: "Submit"
                    on_release: root.save_api_key()
                    size_hint_x: 0.3
                    font_name: "Roboto"
                    md_bg_color: 0.4, 0.3, 0.5, 1  # Dark purple

# --- Website Data Screen ---
# For entering credentials for external websites.
<WebsiteDataScreen>:
    name: "enter web data"
    on_enter: root.prepare_screen()
    on_leave: root.reset_screen()
    MDFloatLayout:

        MDIconButton:
            icon: "home"
            pos_hint: {"top": 0.97, "right": 0.96}
            on_release: root.manager.current = "main"
            icon_size: "48sp"
            theme_text_color: "Custom"
            text_color: 0.8, 0.6, 1, 1  # Light purple

        # --- Form Card ---
        MDCard:
            id: website_data_card
            orientation: "vertical"
            size_hint: 0.85, 0.65
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            elevation: 2
            radius: [16]
            padding: "24dp"
            spacing: "20dp"

            MDLabel:
                id: website_label
                text: "Connect to Website Account"
                font_style: "H4"
                bold: True
                halign: "center"
                size_hint_y: None
                height: self.texture_size[1]
                padding_y: "15dp"
                theme_text_color: "Custom"
                text_color: 0.8, 0.6, 1, 1  # Light purple
                font_name: "data/fonts/Roboto-BoldItalic.ttf"

            MDTextField:
                id: username_field
                hint_text: "Enter email or username:"
                helper_text: "Example: Simeon"
                helper_text_mode: "on_focus"
                icon_right: "account"
                mode: "rectangle"

            MDTextField:
                id: password_field
                hint_text: "Enter password:"
                helper_text: "Example: HelloWorld123"
                helper_text_mode: "on_focus"
                icon_right: "key-variant"
                password: True
                mode: "rectangle"

            Widget:  # Spacer

            MDFillRoundFlatButton:
                id: submit_button
                text: "Submit"
                pos_hint: {"center_x": 0.5}
                size_hint_x: 0.8
                on_press: root.save_to_login()
                on_release: root.manager.current = "main"

        MDFillRoundFlatButton:
            id: disconnect_button
            text: "Disconnect"
            md_bg_color: 0.8, 0.1, 0.1, 1  # Red
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            size_hint: 0.6, 0.1
            opacity: 0
            disabled: True
            on_release: root.disconnect_website()

        MDLabel:
            id: dis_label
            text: "Connect to Website Account"
            font_style: "H4"
            bold: True
            halign: "center"
            pos_hint: {"center_y": 0.88}
            size_hint_y: None
            height: self.texture_size[1]
            padding_y: "15dp"
            padding_x: "15dp"
            opacity: 0
            theme_text_color: "Custom"
            text_color: 0.8, 1, 0.6, 1  # Light green
            font_name: "data/fonts/Roboto-BoldItalic.ttf"

# --- Add Class Screen ---
# For adding a new class to the application.
<ClassAddScreen>:
    name: "add a class"
    MDFloatLayout:
        md_bg_color: 0.1, 0.1, 0.1, 1  # Dark background

        MDIconButton:
            icon: "home"
            pos_hint: {"top": 0.97, "right": 0.96}
            on_release: root.manager.current = "main"
            icon_size: "48sp"
            theme_text_color: "Custom"
            text_color: 0.8, 0.6, 1, 1  # Light purple

        MDCard:
            orientation: "vertical"
            size_hint: 0.85, 0.65
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            elevation: 2
            radius: [24]
            padding: "24dp"
            spacing: "20dp"
            md_bg_color: 0.2, 0.2, 0.2, 1  # Darker card

            MDLabel:
                text: "New Class"
                font_style: "H4"
                bold: True
                halign: "center"
                size_hint_y: None
                height: self.texture_size[1]
                padding_y: "10dp"
                theme_text_color: "Custom"
                text_color: 0.8, 0.6, 1, 1  # Light purple
                font_name: "data/fonts/Roboto-BoldItalic.ttf"

            MDTextField:
                id: class_name
                hint_text: "Enter Class Name:"
                helper_text: "Example: Math"
                helper_text_mode: "on_focus"
                icon_right: "book-open-outline"
                mode: "rectangle"
                font_name: "Roboto"
                line_color_normal: 0.4, 0.3, 0.5, 1  # Dark purple
                line_color_focus: 0.9, 0.9, 1, 1  # Light purple
                text_color_normal: 0.9, 0.9, 0.9, 1  # Light gray
                hint_text_color: 0.6, 0.6, 0.6, 1  # Gray

            MDRaisedButton:
                id: assignment_website
                text: "Select Assignment Website"
                pos_hint: {"center_x": 0.5}
                size_hint_x: 0.6
                on_release: root.open_menu()
                font_name: "RobotoMedium"
                md_bg_color: 0.4, 0.3, 0.5, 1  # Dark purple

            MDTextField:
                id: assignment_page_input
                hint_text: "Enter the Assignment Page Link:"
                helper_text: "Example: school.com/assignments"
                helper_text_mode: "on_focus"
                icon_right: "link"
                mode: "rectangle"
                font_name: "Roboto"
                line_color_normal: 0.4, 0.3, 0.5, 1  # Dark purple
                line_color_focus: 0.9, 0.9, 1, 1  # Light purple
                text_color_normal: 0.9, 0.9, 0.9, 1  # Light gray
                hint_text_color: 0.6, 0.6, 0.6, 1  # Gray

            Widget:  # Spacer

            MDFillRoundFlatButton:
                text: "+ ADD this class"
                pos_hint: {"center_x": 0.5}
                size_hint_x: 0.8
                on_press: root.save_to_class()
                md_bg_color: 0.4, 0.3, 0.5, 1  # Dark purple
                on_release: root.manager.current = "main"
                font_name: "RobotoMedium"

# --- Sign In Screen ---
# For user authentication.
<SignInScreen>:
    name: "sign in"
    MDFloatLayout:
        md_bg_color: 0.1, 0.1, 0.1, 1  # Dark background

        MDIconButton:
            icon: "home"
            pos_hint: {"top": 0.97, "right": 0.96}
            on_release: root.manager.current = "main"
            icon_size: "48sp"
            theme_text_color: "Custom"
            text_color: 0.8, 0.6, 1, 1  # Light purple

        MDCard:
            id: sign_in_card
            orientation: "vertical"
            size_hint: 0.85, 0.65
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            elevation: 2
            radius: [24]
            padding: "24dp"
            spacing: "20dp"
            md_bg_color: 0.2, 0.2, 0.2, 1  # Darker card

            MDLabel:
                text: "Create Account or Log Back In"
                font_style: "H4"
                bold: True
                halign: "center"
                size_hint_y: None
                height: self.texture_size[1]
                padding_y: "15dp"
                theme_text_color: "Custom"
                text_color: 0.9, 0.9, 0.9, 1  # Light gray
                font_name: "Comic"

            MDTextField:
                id: username_field
                hint_text: "Create username:"
                helper_text: "Example: Simeon"
                helper_text_mode: "on_focus"
                icon_right: "account"
                mode: "rectangle"
                font_name: "Roboto"
                line_color_normal: 0.4, 0.3, 0.5, 1  # Dark purple
                line_color_focus: 0.9, 0.9, 1, 1  # Light purple
                text_color_normal: 0.9, 0.9, 0.9, 1  # Light gray
                hint_text_color: 0.6, 0.6, 0.6, 1  # Gray

            MDTextField:
                id: pin_field
                hint_text: "Create pin:"
                helper_text: "Example: 19674"
                helper_text_mode: "on_focus"
                icon_right: "key-variant"
                password: True
                mode: "rectangle"
                font_name: "Roboto"
                line_color_normal: 0.4, 0.3, 0.5, 1  # Dark purple
                line_color_focus: 0.9, 0.9, 1, 1  # Light purple
                text_color_normal: 0.9, 0.9, 0.9, 1  # Light gray
                hint_text_color: 0.6, 0.6, 0.6, 1  # Gray

            Widget:  # Spacer

            MDFillRoundFlatButton:
                text: "Submit"
                pos_hint: {"center_x": 0.5}
                size_hint_x: 0.8
                on_press: root.sign_in()
                on_release: root.manager.current = "main"
                font_name: "Roboto"
                md_bg_color: 0.4, 0.3, 0.5, 1  # Dark purple

        MDFillRoundFlatButton:
            id: sign_out_button
            text: "Log Out"
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            size_hint: 0.6, 0.1
            opacity: 0
            disabled: True
            on_release: root.sign_out()
            font_name: "Comic"
            md_bg_color: 0.8, 0.1, 0.1, 1  # Red

# --- Edit Class Screen ---
# For modifying existing class details.
<ClassEditScreen>:
    name: "edit class"
    MDFloatLayout:
        md_bg_color: 0.1, 0.1, 0.1, 1  # Dark background

        MDIconButton:
            icon: "home"
            pos_hint: {"top": 0.97, "right": 0.96}
            on_release: root.manager.current = "main"
            icon_size: "48sp"
            theme_text_color: "Custom"
            text_color: 0.8, 0.6, 1, 1  # Light purple

        MDCard:
            orientation: "vertical"
            size_hint: 0.85, 0.75
            pos_hint: {"center_x": 0.5, "center_y": 0.5}
            elevation: 2
            radius: [24]
            padding: "24dp"
            spacing: "15dp"
            md_bg_color: 0.2, 0.2, 0.2, 1  # Darker card

            MDLabel:
                text: "Edit Class"
                font_style: "H4"
                bold: True
                halign: "center"
                size_hint_y: None
                height: self.texture_size[1]
                padding_y: "10dp"
                theme_text_color: "Custom"
                text_color: 0.8, 0.6, 1, 1  # Light purple
                font_name: "data/fonts/Roboto-BoldItalic.ttf"

            MDLabel:
                text: "Select class to replace"
                font_style: "H5"
                halign: "center"
                pos_hint: {"center_x": 0.5}
                theme_text_color: "Custom"
                text_color: 0.9, 0.9, 0.9, 1  # Light gray
                font_name: "RobotoLight"

            MDRaisedButton:
                id: class_dropdown_btn
                text: "Select a Class"
                pos_hint: {"center_x": 0.5}
                size_hint_x: 0.4
                on_release: root.open_menu()
                font_name: "RobotoMedium"
                md_bg_color: 0.4, 0.3, 0.5, 1  # Dark purple

            MDTextField:
                id: class_name
                hint_text: "new Class Name:"
                helper_text: "Example: Math"
                helper_text_mode: "on_focus"
                icon_right: "book-open-outline"
                mode: "rectangle"
                font_name: "RobotoMedium"
                line_color_normal: 0.4, 0.3, 0.5, 1  # Dark purple
                line_color_focus: 0.9, 0.9, 1, 1  # Light purple
                text_color_normal: 0.9, 0.9, 0.9, 1  # Light gray
                hint_text_color: 0.6, 0.6, 0.6, 1  # Gray

            MDRaisedButton:
                id: assignment_website
                text: "Select Assignment Website"
                pos_hint: {"center_x": 0.5}
                size_hint_x: 0.6
                on_release: root.open_web_menu()
                font_name: "RobotoMedium"
                md_bg_color: 0.4, 0.3, 0.5, 1  # Dark purple

            MDTextField:
                id: assignment_page
                hint_text: "Enter Class Page Link:"
                helper_text: "Example: school.com/assignments"
                helper_text_mode: "on_focus"
                icon_right: "tag"
                mode: "rectangle"
                font_name: "RobotoMedium"
                line_color_normal: 0.4, 0.3, 0.5, 1  # Dark purple
                line_color_focus: 0.9, 0.9, 1, 1  # Light purple
                text_color_normal: 0.9, 0.9, 0.9, 1  # Light gray
                hint_text_color: 0.6, 0.6, 0.6, 1  # Gray

            Widget:  # Spacer

            MDBoxLayout:
                orientation: "horizontal"
                spacing: "20dp"
                pos_hint: {"center_x": 0.5}
                size_hint_x: 0.8

                MDFillRoundFlatButton:
                    text: "Delete Class"
                    pos_hint: {"center_y": 0.5}
                    size_hint_x: 0.5
                    on_press: root.delete_class()
                    font_name: "RobotoMedium"
                    md_bg_color: 0.8, 0.1, 0.1, 1  # Red
                    on_release: root.manager.current = "main"

                MDFillRoundFlatButton:
                    text: "Complete Edit"
                    pos_hint: {"center_y": 0.5}
                    size_hint_x: 0.5
                    on_press: root.edit()
                    on_release: root.manager.current = "main"
                    font_name: "RobotoMedium"
                    md_bg_color: 0.4, 0.3, 0.5, 1  # Dark purple

# --- Classes Screen ---
# Displays a list of classes and allows fetching assignments.
<ClassesScreen>:
    name: "classes"
    on_enter: root.populate_classes()
    md_bg_color: 0.08, 0.08, 0.08, 1  # Very dark gray

    MDBoxLayout:
        orientation: 'vertical'
        padding: dp(20)
        spacing: dp(20)

        MDBoxLayout:
            orientation: 'horizontal'
            size_hint_y: None
            height: self.minimum_height
            MDLabel:
                text: "Send assignments to Tasks"
                font_style: "H4"
                theme_text_color: "Custom"
                text_color: 0.8, 0.6, 1, 1  # Light purple
                font_name: "data/fonts/Roboto-BoldItalic.ttf"
                halign: "center"
                size_hint_y: None
                height: self.texture_size[1]
            MDIconButton:
                icon: "home"
                pos_hint: {"center_y": 0.5}
                icon_size: "48sp"
                theme_text_color: "Custom"
                text_color: 0.8, 0.6, 1, 1  # Light purple
                on_release: root.manager.current = "main"

        MDBoxLayout:
            orientation: 'horizontal'
            spacing: dp(20)

            MDBoxLayout:
                orientation: 'vertical'
                size_hint_x: 0.4
                spacing: dp(10)

                MDRaisedButton:
                    text: "Get assignments from ALL classes"
                    size_hint_y: None
                    height: "48dp"
                    size_hint_x: 1.0
                    font_name: "RobotoMedium"
                    md_bg_color: 0.4, 0.3, 0.5, 1  # Dark purple
                    on_press: root.extract_all()

                MDSeparator:
                    height: "1dp"

                ScrollView:
                    MDBoxLayout:
                        id: class_button_container
                        orientation: 'vertical'
                        spacing: dp(15)
                        size_hint_y: None
                        height: self.minimum_height
                        MDFillRoundFlatButton:
                            text: "Add Class"
                            on_release: root.manager.current = "add a class"
                            size_hint_x: 1
                            height: "48dp"

            MDCard:
                id: main_content_panel
                orientation: 'vertical'
                padding: dp(25)
                spacing: dp(15)
                md_bg_color: 0.05, 0.05, 0.05, 1  # Very dark gray
                line_color: 0.4, 0.6, 0.8, 1  # Blue
                radius: [20, 20, 20, 20]
                size_hint_x: 0.6

                MDBoxLayout:
                    orientation: 'horizontal'
                    size_hint_y: None
                    height: dp(60)

                    MDBoxLayout:
                        orientation: 'vertical'
                        MDLabel:
                            id: class_title
                            text: "Class Title"
                            font_style: "H4"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: 0.9, 0.9, 0.9, 1  # Light gray
                        MDLabel:
                            id: class_website
                            text: "Class Website"
                            font_style: "H5"
                            bold: True
                            theme_text_color: "Custom"
                            text_color: 0.6, 0.5, 1.0, 1  # Light purple

                    MDRoundFlatButton:
                        text: "Send to tasks"
                        theme_text_color: "Custom"
                        text_color: 1, 1, 1, 1  # White
                        line_color: 1, 1, 1, 1  # White
                        font_style: "Subtitle1"
                        bold: True
                        pos_hint: {"center_y": .5}
                        on_press: root.get_assignments_to_tasks()

                MDSeparator:
                    color: 1, 1, 1, 1  # White
                    height: dp(2)

                MDRelativeLayout:
                    MDCard:
                        md_bg_color: 0.3, 0.18, 0.35, 1  # Dark purple
                        line_color: 0.6, 0.5, 1.0, 1  # Light purple
                        radius: [15, 15, 15, 15]
                        padding: dp(15)

                        MDLabel:
                            id: copy_box
                            text: " "
                            theme_text_color: "Custom"
                            text_color: 1, 1, 1, 1  # White

                    MDFillRoundFlatButton:
                        text: "Copy"
                        md_bg_color: 0.1, 0.3, 0.5, 1  # Dark blue
                        text_color: 0.5, 0.7, 1.0, 1  # Light blue
                        line_color: 0.3, 0.6, 0.9, 1  # Blue
                        bold: True
                        font_style: "H6"
                        pos_hint: {"top": 0.92, "right": 0.96}
                        on_press: root.copy_to_clipboard()